# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data — raw datasets and processed HDF5 files are NOT committed
# (too large; download instructions are in docs/data_setup.md)
data/raw/mit-bih/*.dat
data/raw/mit-bih/*.hea
data/raw/mit-bih/*.atr
data/raw/mit-bih/*.xws
data/raw/eeg-motor/S*/
data/raw/ppg-dalia/*.pkl
data/processed/*.h5
data/processed/*.npz
data/processed/*.csv

# Keep .gitkeep placeholders so directory structure is tracked
!data/raw/mit-bih/.gitkeep
!data/raw/eeg-motor/.gitkeep
!data/raw/ppg-dalia/.gitkeep
!data/processed/.gitkeep

# Model outputs — checkpoints and results are NOT committed
outputs/
!outputs/.gitkeep

# Logs
*.log
run.log

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# IDEs
.idea/
.vscode/
*.swp
*.swo

# Profiling
*.prof
*.lprof
